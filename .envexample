# Legg denne inn som `.env.local` og fyll inn verdiene fra Firebase Console.
# Viktig: Ikke committ faktisk innhold i `.env.local` til git.

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=optional_measurement_id

# Server-side: last ned service account JSON fra Firebase Console (Project settings → Service accounts)
# og lim inn hele JSON som én linje (anbefalt for Vercel). Kreves for franchise-API (verifiserer ID-token og leser Firestore).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

